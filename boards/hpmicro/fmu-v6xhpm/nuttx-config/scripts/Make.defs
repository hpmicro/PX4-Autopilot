HPM_CHIP_SERIES = HPM6700
HPM_CHIP_SELECT = HPM6750
HPM_BOARD_SELECT = px4_fmu_v6xhpm
CONFIG_XIP_FLASH_SIZE = 16M

CFLAGS += -DFLASH_XIP
LDFLAGS += --defsym=_flash_size=$(CONFIG_XIP_FLASH_SIZE)

LDFLAGS += --defsym=_stack_size=$(CONFIG_IDLETHREAD_STACKSIZE)
LDFLAGS += --defsym=_heap_size=$(CONFIG_NON_OS_HEAPSIZE)
LDFLAGS += --defsym=_nx_heap_size=$(CONFIG_SYSTEM_HEAPSIZE)

# Add include directories
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)arch
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)arch$(DELIM)riscv$(DELIM)l1c
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)soc$(DELIM)${HPM_CHIP_SERIES}$(DELIM)$(HPM_CHIP_SELECT)
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)soc$(DELIM)${HPM_CHIP_SERIES}$(DELIM)$(HPM_CHIP_SELECT)$(DELIM)boot
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)soc$(DELIM)${HPM_CHIP_SERIES}$(DELIM)ip
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)drivers$(DELIM)inc
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)boards$(DELIM)$(HPM_BOARD_SELECT)
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components$(DELIM)adc
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components$(DELIM)camera
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components$(DELIM)camera$(DELIM)mt9m114
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components$(DELIM)camera$(DELIM)ov5640
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components$(DELIM)camera$(DELIM)ov7725
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components$(DELIM)codec$(DELIM)sgtl5000
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components$(DELIM)codec$(DELIM)wm8960
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components$(DELIM)debug_console
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components$(DELIM)dma_mgr
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components$(DELIM)enet_phy
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components$(DELIM)enet_phy$(DELIM)dp83848
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components$(DELIM)enet_phy$(DELIM)dp83867
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components$(DELIM)enet_phy$(DELIM)rtl8201
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components$(DELIM)enet_phy$(DELIM)rtl8211
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components$(DELIM)spi
CFLAGS += -I$(CHIP_DIR)$(DELIM)hpm_sdk$(DELIM)components$(DELIM)uart_lin
CFLAGS += -I$(CHIP_DIR)$(DELIM)
